# secrets / personal config — never commit
.secrets/
.gitconfig
.git-credentials
.env
*.key

# Claude Code config dir (contains auth + session data)
.claude/

# local tooling, envs, caches
tools/
npm-global/
.npm-cache/
.cache/
.venv/
envs/
